      "description": "Controle de 52px em borracha 3.",
      "html": "<div class=\"ds-step\"><button>-</button><input value=\"40\" aria-label=\"Carga\"><button>+</button></div>",
      "css": ":host{--plate:#f0444f;--rubber-2:#1a1a1b;--rubber-3:#252527;--chalk:#f1f1ec;--on-plate:#141414;--muted:#a6a69f;--line:#36363a}.ds-step{display:inline-flex;align-items:center;background:var(--rubber-3);border-radius:14px}.ds-step button{width:52px;height:52px;border:0;background:none;color:var(--chalk);font-size:24px;border-radius:14px;cursor:pointer}.ds-step button:active{background:var(--line)}.ds-step input{width:88px;height:52px;border:0;background:none;color:var(--chalk);text-align:center;font-family:'Big Shoulders Display','Arial Narrow',sans-serif;font-weight:800;font-size:32px}.ds-step :focus-visible{outline:3px solid var(--chalk);outline-offset:3px}"
