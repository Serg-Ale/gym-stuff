      "description": "Série pendente e feita, 56px.",
      "html": "<button class=\"ds-disc\" aria-pressed=\"false\"><span>1</span></button> <button class=\"ds-disc ds-on\" aria-pressed=\"true\"><span>2</span></button>",
      "css": ":host{--plate:#f0444f;--rubber-2:#1a1a1b;--rubber-3:#252527;--chalk:#f1f1ec;--on-plate:#141414;--muted:#a6a69f;--line:#36363a}.ds-disc{width:56px;height:56px;border-radius:50%;border:4px solid var(--plate);background:none;color:var(--chalk);font-family:'Big Shoulders Display','Arial Narrow',sans-serif;font-weight:800;font-size:26px;cursor:pointer;transition:background-color .15s cubic-bezier(.16,1,.3,1)}.ds-on{background:var(--plate);color:var(--on-plate)}.ds-disc:focus-visible{outline:3px solid var(--chalk);outline-offset:3px}"
    },
    {
      "name": "Disco de dia",
      "kind": "nav",
      "refersTo": "day-disc",
