      "html": "<button class=\"ds-day\" style=\"--c:#4a7cf0\">TER</button> <button class=\"ds-day ds-sel\" style=\"--c:#f2c230\">QUA</button>",
      "css": ":host{--plate:#f0444f;--rubber-2:#1a1a1b;--rubber-3:#252527;--chalk:#f1f1ec;--on-plate:#141414;--muted:#a6a69f;--line:#36363a}.ds-day{width:56px;height:56px;border-radius:50%;border:4px solid var(--c);background:none;color:var(--chalk);font-family:'Big Shoulders Display','Arial Narrow',sans-serif;font-weight:800;font-size:19px;letter-spacing:.04em;cursor:pointer}.ds-sel{background:var(--c);color:var(--on-plate)}.ds-day:active{transform:scale(.94)}.ds-day:focus-visible{outline:3px solid var(--chalk);outline-offset:3px}"
    },
    {
      "name": "Régua proporcional",
      "kind": "custom",
      "description": "Segmentos com largura = séries; triângulo de giz no exercício atual.",
      "html": "<ol class=\"ds-rail\"><li style=\"flex:4 1 0\"><i class=\"ds-f\" style=\"width:100%\"></i></li><li style=\"flex:4 1 0\" class=\"ds-cur\"><i class=\"ds-f\" style=\"width:50%\"></i></li><li style=\"flex:3 1 0\"><i class=\"ds-f\" style=\"width:0\"></i></li></ol>",
      "css": ":host{--plate:#f0444f;--rubber-2:#1a1a1b;--rubber-3:#252527;--chalk:#f1f1ec;--on-plate:#141414;--muted:#a6a69f;--line:#36363a}.ds-rail{list-style:none;display:flex;gap:4px;margin:0;padding:0}.ds-rail li{position:relative;height:10px;margin-top:10px;border-radius:3px;background:var(--rubber-3);overflow:visible}.ds-f{display:block;height:100%;background:var(--plate);border-radius:3px}.ds-cur::before{content:'';position:absolute;left:50%;top:-9px;margin-left:-6px;border:6px solid transparent;border-top-color:var(--chalk);border-bottom:0}"
    },
    {
